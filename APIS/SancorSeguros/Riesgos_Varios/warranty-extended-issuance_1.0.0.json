{
    "swagger": "2.0",
    "info": {
        "version": "1.0.0",
        "description": "servicio para Emitir Garant\u00eda Extendida",
        "title": "Emisi\u00f3n - Riesgos Varios - Garant\u00eda Extendida"
    },
    "paths": {
        "/policies/serveralRisk/warrantyextended": {
            "post": {
                "operationId": "Emite p\u00f3lizas del ramo 'Riesgos Varios'",
                "responses": {
                    "200": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/singlePolicyResponse"
                        }
                    },
                    "400": {
                        "description": "Parametros de entrada invalidos/mal escritos.",
                        "schema": {
                            "$ref": "#/definitions/Message"
                        }
                    },
                    "401": {
                        "description": "Authentication.",
                        "schema": {
                            "$ref": "#/definitions/Message"
                        }
                    },
                    "403": {
                        "description": "Authorization.",
                        "schema": {
                            "$ref": "#/definitions/Message"
                        }
                    },
                    "415": {
                        "description": "Faltan parametros de entrada obligatorios.",
                        "schema": {
                            "$ref": "#/definitions/Message"
                        }
                    },
                    "422": {
                        "description": "Parametros de entrada con valores incorrectos.",
                        "schema": {
                            "$ref": "#/definitions/Message"
                        }
                    },
                    "500": {
                        "description": "No response from Backend.",
                        "schema": {
                            "$ref": "#/definitions/Message"
                        }
                    },
                    "504": {
                        "description": "TimeOut from server.",
                        "schema": {
                            "$ref": "#/definitions/Message"
                        }
                    }
                },
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "description": "Operaci\u00f3n para crear una p\u00f3liza.",
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/singlePolicy"
                        },
                        "description": "body",
                        "required": true
                    },
                    {
                        "name": "Authorization",
                        "in": "header",
                        "type": "string",
                        "description": "Token de Usuario.",
                        "required": true
                    },
                    {
                        "name": "TransactionId",
                        "in": "header",
                        "type": "string"
                    }
                ]
            }
        }
    },
    "definitions": {
        "branchDataCollection": {
            "type": "object",
            "properties": {
                "warrantyMonths": {
                    "type": "integer",
                    "description": "Meses Garantia Oficial",
                    "example": 12
                },
                "severalRiskItems": {
                    "type": "array",
                    "properties": {
                        "dataSeveralRiskType": {
                            "type": "object",
                            "properties": {
                                "amount": {
                                    "type": "number",
                                    "format": "decimal",
                                    "description": "suma asegurada",
                                    "example": 300000
                                },
                                "description": {
                                    "type": "string",
                                    "description": "descripcion del bien",
                                    "example": "Microondas 20lts"
                                },
                                "currency": {
                                    "type": "string",
                                    "description": "moneda (siempre es pesos)",
                                    "example": "Pesos"
                                },
                                "category": {
                                    "type": "integer",
                                    "description": "categoria del bien asegurado",
                                    "example": 92
                                },
                                "group": {
                                    "type": "integer",
                                    "description": "grupo del bien asegurado",
                                    "example": 34
                                },
                                "serie": {
                                    "type": "string",
                                    "description": "n\u00famero de serie del bien",
                                    "example": 334487120
                                }
                            },
                            "required": [
                                "amount",
                                "category",
                                "group"
                            ]
                        }
                    }
                }
            },
            "required": [
                "warrantyMonths"
            ]
        },
