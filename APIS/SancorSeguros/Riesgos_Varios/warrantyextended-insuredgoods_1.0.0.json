{
    "openapi": "3.0.0",
    "info": {
        "title": "Api Consulta de Grupos y Categor\u00edas de Bienes Asegurados",
        "description": "servicio para obtener valores de bienes asegurados: grupos / categorias.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://external-pre-api.gruposancorseguros.com/apissa/pre-catalog/insuredGoods/warranty/extended"
        }
    ],
    "paths": {
        "/properties/groups": {
            "get": {
                "parameters": [
                    {
                        "name": "Authorization",
                        "in": "header",
                        "required": true,
                        "style": "simple",
                        "explode": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "statisticCode",
                        "in": "query",
                        "description": "codgio de Grupo Estadistico.",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "groups": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "number"
                                                    },
                                                    "description": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
                                    },
                                    "example": "{\"groups\":[{\"id\":4,\"description\":\"COMPUTACION\"},{\"id\":10,\"description\":\"OTROS\"},{\"id\":13,\"description\":\"L\u00cdNEA BLANCA\"},{\"id\":16,\"description\":\"CELULARES\"}]}"
                                }
                            }
                        }
                    }
                }
            },
            "description": "Listado de grupo de bienes."
        },
        "/properties/categories": {
            "get": {
